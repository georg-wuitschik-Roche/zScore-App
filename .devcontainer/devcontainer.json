{
	"name": "zScore Dashboard",
	"image": "eu.repository.roche.com/cde-gitpod-docker-prd-l/ona-base:2.0",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22"
		}
	},
	"forwardPorts": [5173],
	"postCreateCommand": ".devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"anthropic.claude-code"
			]
		}
	},
	"postStartCommand": "nohup .devcontainer/start-dev.sh > /tmp/dev-server.log 2>&1 &"
}

{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pre-commit run --all-files",
            "if": "Bash(git commit*)",
            "statusMessage": "Running pre-commit hooks..."
          }
        ]
      }
    ]
  }
}
